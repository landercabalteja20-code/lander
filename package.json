{
  "name": "lander",
  "version": "1.0.0",
  "private": true,
  "description": "3D animation with Three.js + Remotion (captions, audio, video rendering)",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Main out/video.mp4",
    "still": "remotion still Main out/thumbnail.png --frame=60",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "render:cpu": "remotion render Main out/video.mp4 --gl=swangle",
    "ants:audio": ".venv/bin/python tools/ants/build_audio.py",
    "ants:preview": "node tools/ants/preview.mjs out/preview",
    "ants:render": "remotion render WhatIfAnts done/what-if-humans-shrank-to-ants.mp4 --gl=swangle --concurrency=4",
    "genz:audio": ".venv/bin/python tools/genz/build_audio.py",
    "genz:still": "node tools/genz/still.mjs WhatIfGenZ1850 out/genz-preview",
    "genz:render": "remotion render WhatIfGenZ1850 done/what-if-genz-1850.mp4 --gl=swangle --concurrency=4"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "^4.0.541",
    "@remotion/cli": "^4.0.541",
    "@remotion/media": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "@remotion/three": "^4.0.541",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "hyperframes": "^0.9.23",
    "typescript": "^5.9.3"
  }
}
