{
  "name": "lander",
  "version": "1.0.0",
  "private": true,
  "description": "3D animation with Three.js + Remotion (captions, audio, video rendering)",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Main out/video.mp4",
    "still": "remotion still Main out/thumbnail.png --frame=60",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "render:cpu": "remotion render Main out/video.mp4 --gl=swangle"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "^4.0.541",
    "@remotion/cli": "^4.0.541",
    "@remotion/media": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "@remotion/three": "^4.0.541",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3"
  }
}
