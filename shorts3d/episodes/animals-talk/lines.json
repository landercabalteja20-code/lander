 "lines": [
  {
   "id": "n1",
   "who": "narrator",
   "text": "If animals could suddenly talk, your dog would wake you up at five a.m. to say one word.",
   "caption": "If animals could suddenly talk, your dog would wake you up at 5 a.m. to say one word.",
   "gap": 0.28
  },
  {
   "id": "dog1",
   "who": "dog",
   "text": "Walk.",
   "gap": 0.26
  },
  {
   "id": "dog2",
   "who": "dog",
   "text": "Walk?",
   "gap": 0.24
  },
  {
   "id": "dog3",
   "who": "dog",
   "text": "Walk!",
   "gap": 0.34,
   "speed": 0.95,
   "gain": 1.5
  },
  {
   "id": "n2",
   "who": "narrator",
   "text": "You see, the average dog knows about a hundred and sixty-five words, and it would use all of them to ask for food.",
   "caption": "You see, the average dog knows about 165 words, and it would use all of them to ask for food.",
   "gap": 0.3
  },
  {
   "id": "n3",
   "who": "narrator",
   "text": "Your cat, strangely, wouldn't say a thing.",
   "gap": 0.42
  },
  {
   "id": "n4",
   "who": "narrator",
   "text": "The problem is, Earth has one and a half billion cows, and they'd all have questions about burgers.",
   "caption": "The problem is, Earth has 1.5 billion cows, and they'd all have questions about burgers.",
   "gap": 0.3
  },
  {
   "id": "cow",
   "who": "cow",
   "text": "We need to talk.",
   "gap": 0.36
  },
  {
   "id": "n5",
   "who": "narrator",
   "text": "Pigeons would roast everyone from the rooftops.",
   "gap": 0.22
  },
  {
   "id": "pigeon",
   "who": "pigeon",
   "text": "Nice bald spot!",
   "gap": 0.36
  },
  {
   "id": "n6",
   "who": "narrator",
   "text": "And your parrot would repeat everything you ever said about your boss, to your boss.",
   "caption": "And your parrot would repeat everything you ever said about your boss... to your boss.",
   "gap": 0.2
  },
  {
   "id": "parrot",
   "who": "parrot",
   "text": "Gary smells like soup!",
   "gap": 0.9
  },
  {
   "id": "n7",
   "who": "narrator",
   "text": "But when someone finally asked the cat why it never said a word...",
   "gap": 0.5
  },
  {
   "id": "cat",
   "who": "cat",
   "text": "Oh, we could always talk. We just didn't want to.",
   "gap": 0.0
  }
 ],
